# Environment Variables Template
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Server-only (never prefixed VITE_; these must not reach the browser) ─────

# AES-256-GCM key for the Gmail app password in org_secrets.
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# HMAC key for recipient-portal links. 32+ characters.
# Generate with: openssl rand -base64 48
PORTAL_TOKEN_SECRET=

# NVIDIA API key for the AI co-founder. Read by api/nvidia.js only.
#
# NOT VITE_NVIDIA_API_KEY. Vite inlines every VITE_-prefixed variable into the
# client bundle as a string literal, so the old name in this template published
# the key to anyone who opened devtools — and api/nvidia.js does not read it
# under that name anyway, so following the template left the endpoint broken as
# well as the key exposed.
NVIDIA_API_KEY=nvapi-your-key-here

# Comma-separated origins portal links may be built for. Leave blank to use the
# request's own host (fine for a single deployment).
PORTAL_ALLOWED_ORIGINS=
