{
    "crons": [
        {
            "path": "/api/agents",
            "schedule": "30 2 * * *"
        }
    ],
    "functions": {
        "api/agents.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
